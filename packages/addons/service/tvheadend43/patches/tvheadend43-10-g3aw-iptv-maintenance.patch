+/*
+ * G3AW-R2C12: remove precisely one channel/tag association.
+ *
+ * The caller must perform ownership and dependency checks before
+ * invoking this function. No global Channel Tag object is deleted.
+ */
+int
+channel_tag_unmap_exact(channel_tag_t *ct, channel_t *ch)
+{
+  idnode_list_mapping_t *ilm;
+
+  if (!ct || !ch)
+    return 0;
+
+  LIST_FOREACH(ilm, &ch->ch_ctms, ilm_in2_link) {
+    if (ilm->ilm_in1 != &ct->ct_id ||
+        ilm->ilm_in2 != &ch->ch_id)
+      continue;
+
+    /*
+     * The Channel Tag is endpoint 1. Passing its idnode as origin
+     * schedules persistence of endpoint 2 (the channel).
+     */
+    idnode_list_unlink(ilm, &ct->ct_id);
+
+    if (ct->ct_enabled && !ct->ct_internal) {
+      htsp_channel_update(ch);
+      htsp_tag_update(ct);
+    }
+
+    return 1;
+  }
+
+  return 0;
+}
