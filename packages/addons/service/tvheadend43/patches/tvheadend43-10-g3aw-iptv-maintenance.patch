+/*
+ * G3AW-R2B: add M3U groups to already mapped IPTV channels.
+ *
+ * ADD ONLY. Existing associations have no provenance metadata,
+ * so removing them here would risk deleting manual assignments.
+ *
+ * Called only by the HTTP/HTTPS auto-network download callback
+ * while global_lock is held.
+ */
+/*
+ * G3AW-R2C5: remember only channel/tag links created by this
+ * IPTV reconciler. No historical association is adopted.
+ *
+ * Persisted format (per mux):
+ *   v1\n
+ *   32-hex-channel-uuid:32-hex-tag-uuid\n
+ *
+ * This is a write-only ledger at this stage. No removals.
+ */
+/* G3AW-R2C22: complete ledger validation for writer. */
+static int g3aw_managed_link_lookup(
+  iptv_mux_t *im, channel_t *ch, channel_tag_t *ct);
+
+static int
+g3aw_record_managed_tag_link(iptv_mux_t *im,
+                             channel_t *ch, channel_tag_t *ct)
+{
+  char channel_uuid[UUID_HEX_SIZE];
+  char tag_uuid[UUID_HEX_SIZE];
+  char entry[2 * UUID_HEX_SIZE + 4];
+  const char *old = im->mm_iptv_managed_tag_links;
+  const char *p;
+  char *updated;
+  size_t old_len, entry_len, header_len;
+  int n;
+  int ownership_state;
+
+
+  /*
+   * G3AW-R2C22:
+   * Validate the complete ownership ledger before any append.
+   * A corrupt or globally duplicated ledger must never be extended.
+   */
+  ownership_state = g3aw_managed_link_lookup(im, ch, ct);
+
+  if (ownership_state < 0)
+    return -1;
+
+  if (ownership_state == 1)
+    return 0;
+
+  idnode_uuid_as_str(&ch->ch_id, channel_uuid);
+  idnode_uuid_as_str(&ct->ct_id, tag_uuid);
+
+  n = snprintf(entry, sizeof(entry), "%s:%s\n",
+               channel_uuid, tag_uuid);
+  if (n < 0 || (size_t)n >= sizeof(entry))
+    return -1;
+
+  entry_len = (size_t)n;
+  header_len = old && *old ? 0 : 3;
+  old_len = old && *old ? strlen(old) : 0;
+
+  /* Do not extend unknown or malformed ledger versions. */
+  if (old_len) {
+    if (old_len < 3 || strncmp(old, "v1\n", 3))
+      return -1;
+
+    p = old + 3;
+    while (*p) {
+      size_t i;
+
+      /* An entry must contain 65 characters plus newline.
+       * Reject truncated records before indexed access. */
+      if (strnlen(p, 66) != 66)
+        return -1;
+
+      for (i = 0; i < 32; i++)
+        if (!((p[i] >= '0' && p[i] <= '9') ||
+              (p[i] >= 'a' && p[i] <= 'f')))
+          return -1;
+      if (p[32] != ':')
+        return -1;
+      for (i = 33; i < 65; i++)
+        if (!((p[i] >= '0' && p[i] <= '9') ||
+              (p[i] >= 'a' && p[i] <= 'f')))
+          return -1;
+      if (p[65] != '\n')
+        return -1;
+      if (!strncmp(p, entry, entry_len))
+        return 0;
+      p += 66;
+    }
+  }
+
+  if (old_len > 1048576 ||
+      entry_len > 1048576 - old_len - header_len)
+    return -1;
+
+  updated = malloc(old_len + header_len + entry_len + 1);
+  if (!updated)
+    return -1;
+
+  if (old_len)
+    memcpy(updated, old, old_len);
+  else
+    memcpy(updated, "v1\n", 3);
+
+  memcpy(updated + old_len + header_len, entry, entry_len);
+  updated[old_len + header_len + entry_len] = '\0';
+
+  im->mm_iptv_managed_tag_links = updated;
+  free((char *)old);
+
+  idnode_changed(&im->mm_id);
+  return 1;
+}
+
+
+/*
+ * G3AW-R2C16: read-only dependency evaluation.
+ *
+ * IMPORTANT:
+ * OBSOLETE_CANDIDATE does not authorize unlinking.
+ * The ownership ledger does not detect manual user overrides.
+ *
+ * Caller must hold the global lock.
+ */
+typedef enum {
+  G3AW_TAG_DEPENDENCY_BLOCKED = -1,
+  G3AW_TAG_DEPENDENCY_OBSOLETE_CANDIDATE = 0,
+  G3AW_TAG_DEPENDENCY_REQUIRED = 1
+} g3aw_tag_dependency_result_t;
+
+static g3aw_tag_dependency_result_t __attribute__((unused))
+g3aw_evaluate_channel_tag_dependency(
+  iptv_mux_t *owner, channel_t *ch, channel_tag_t *ct)
+{
+  idnode_list_mapping_t *ilm;
+  service_t *s;
+  mpegts_service_t *ms;
+  htsmsg_t *tags;
+  htsmsg_field_t *field;
+  const char *name;
+  int services_seen = 0;
+  int owner_service_seen = 0;
+  int required = 0;
+  int blocked = 0;
+
+  lock_assert(&global_lock);
+
+  if (!owner || !ch || !ct)
+    return G3AW_TAG_DEPENDENCY_BLOCKED;
+
+  LIST_FOREACH(ilm, &ch->ch_services, ilm_in2_link) {
+    if (ilm->ilm_in2 != &ch->ch_id || !ilm->ilm_in1) {
+      blocked = 1;
+      continue;
+    }
+
+    s = (service_t *)ilm->ilm_in1;
+    services_seen++;
+
+    /*
+     * A service whose mux/type cannot be established blocks removal.
+     */
+    if (s->s_type != STYPE_STD ||
+        s->s_source_type != S_MPEG_TS ||
+        !s->s_channel_tags) {
+      blocked = 1;
+      continue;
+    }
+
+    ms = (mpegts_service_t *)s;
+
+    if (!ms->s_dvb_mux ||
+        !idnode_is_instance(&ms->s_dvb_mux->mm_id,
+                            &iptv_mux_class)) {
+      blocked = 1;
+      continue;
+    }
+
+    if (ms->s_dvb_mux == (mpegts_mux_t *)owner)
+      owner_service_seen = 1;
+
+    tags = s->s_channel_tags(s);
+
+    /*
+     * NULL may mean no groups, but can also mean failure to
+     * obtain them. Fail conservatively.
+     */
+    if (!tags) {
+      blocked = 1;
+      continue;
+    }
+
+    HTSMSG_FOREACH(field, tags) {
+      name = htsmsg_field_get_str(field);
+
+      if (!name || !*name) {
+        blocked = 1;
+        continue;
+      }
+
+      /*
+       * Lookup only. Never create a Channel Tag during evaluation.
+       */
+      if (channel_tag_find_by_name(name, 0) == ct)
+        required = 1;
+    }
+
+    htsmsg_destroy(tags);
+  }
+
+  if (!services_seen || !owner_service_seen || blocked)
+    return G3AW_TAG_DEPENDENCY_BLOCKED;
+
+  if (required)
+    return G3AW_TAG_DEPENDENCY_REQUIRED;
+
+  return G3AW_TAG_DEPENDENCY_OBSOLETE_CANDIDATE;
+}
+
+
+/*
+ * G3AW-R2C18: read-only lookup in the persisted ownership ledger.
+ *
+ * Return  1: requested association is recorded exactly once.
+ * Return  0: valid ledger, requested association not recorded.
+ * Return -1: invalid or ambiguous ledger.
+ *
+ * A positive lookup does NOT authorize unlinking.
+ */
+
+/*
+ * G3AW-R2C20: compare the complete channel:tag key.
+ * Record pointers refer to the validated, immutable ledger.
+ */
+static int
+g3aw_managed_link_key_cmp(const void *a, const void *b)
+{
+  const char *left = *(const char * const *)a;
+  const char *right = *(const char * const *)b;
+
+  return memcmp(left, right, 65);
+}
+
+static int __attribute__((unused))
+g3aw_managed_link_lookup(iptv_mux_t *im,
+                         channel_t *ch, channel_tag_t *ct)
+{
+  const char *ledger;
+  char channel_uuid[UUID_HEX_SIZE];
+  char tag_uuid[UUID_HEX_SIZE];
+  size_t len, pos, i, count;
+  const char **entries;
+  int matches = 0;
+
+  if (!im || !ch || !ct)
+    return -1;
+
+  ledger = im->mm_iptv_managed_tag_links;
+
+  if (!ledger || !*ledger)
+    return 0;
+
+  /*
+   * Bound the scan before inspecting records.
+   * All v1 entries are 66 bytes after the three-byte header.
+   */
+  len = strnlen(ledger, 1048577);
+
+  if (len > 1048576 || len < 3 ||
+      memcmp(ledger, "v1\n", 3) != 0 ||
+      (len - 3) % 66 != 0)
+    return -1;
+
+  idnode_uuid_as_str(&ch->ch_id, channel_uuid);
+  idnode_uuid_as_str(&ct->ct_id, tag_uuid);
+
+  for (pos = 3; pos < len; pos += 66) {
+    const char *p = ledger + pos;
+
+    for (i = 0; i < 32; i++) {
+      if (!((p[i] >= '0' && p[i] <= '9') ||
+            (p[i] >= 'a' && p[i] <= 'f')))
+        return -1;
+    }
+
+    if (p[32] != ':')
+      return -1;
+
+    for (i = 33; i < 65; i++) {
+      if (!((p[i] >= '0' && p[i] <= '9') ||
+            (p[i] >= 'a' && p[i] <= 'f')))
+        return -1;
+    }
+
+    if (p[65] != '\n')
+      return -1;
+
+    if (memcmp(p, channel_uuid, 32) == 0 &&
+        memcmp(p + 33, tag_uuid, 32) == 0) {
+      if (++matches > 1)
+        return -1;
+    }
+  }
+
+
+  /*
+   * Validate ALL entries for duplicates, including entries unrelated
+   * to the requested association. Never trust a partially ambiguous
+   * ownership ledger.
+   *
+   * Allocation failure must block the decision, not bypass validation.
+   */
+  count = (len - 3) / 66;
+
+  if (count > 1) {
+    entries = malloc(count * sizeof(*entries));
+    if (!entries)
+      return -1;
+
+    for (i = 0; i < count; i++)
+      entries[i] = ledger + 3 + i * 66;
+
+    qsort(entries, count, sizeof(*entries),
+          g3aw_managed_link_key_cmp);
+
+    for (i = 1; i < count; i++) {
+      if (memcmp(entries[i - 1], entries[i], 65) == 0) {
+        free(entries);
+        return -1;
+      }
+    }
+
+    free(entries);
+  }
+
+  return matches;
+}
+
+static void
+g3aw_map_existing_channel_tags(mpegts_mux_t *mm)
+{
+  mpegts_service_t *ms;
+  service_t *s;
+  idnode_list_mapping_t *ilm;
+  htsmsg_t *tags;
+  htsmsg_field_t *f;
+  channel_tag_t *ct;
+  channel_t *ch;
+  const char *name;
+
+  LIST_FOREACH(ms, &mm->mm_services, s_dvb_mux_link) {
+    s = (service_t *)ms;
+
+    if (!LIST_FIRST(&s->s_channels) || !s->s_channel_tags)
+      continue;
+
+    tags = s->s_channel_tags(s);
+    if (!tags)
+      continue;
+
+    HTSMSG_FOREACH(f, tags) {
+      name = htsmsg_field_get_str(f);
+      if (!name || !*name)
+        continue;
+
+      ct = channel_tag_find_by_name(name, 1);
+      if (!ct)
+        continue;
+
+      LIST_FOREACH(ilm, &s->s_channels, ilm_in1_link) {
+        ch = (channel_t *)ilm->ilm_in2;
+
+        if (channel_tag_map(ct, ch, ch)) {
+          int recorded;
+
+          /* Link has just been created; never adopt existing links. */
+          idnode_changed(&ch->ch_id);
+          recorded = g3aw_record_managed_tag_link(
+            (iptv_mux_t *)mm, ch, ct);
+
+          if (recorded < 0)
+            tvhwarn(LS_IPTV,
+                    "G3AW-R2C5: channel/tag association "
+                    "created without ownership record");
+        }
+      }
+    }
+
+    htsmsg_destroy(tags);
+  }
+}
+
+/*
+ * G3AW-R2C26: remove obsolete, ledger-owned channel/tag links.
+ *
+ * Never adopt historical links. Never delete global Channel Tag
+ * objects. Ambiguous ownership or service dependencies block removal.
+ *
+ * Global lock is held by the HTTP playlist synchronizer.
+ */
+static int
+g3aw_no_other_ledger_owner(iptv_mux_t *owner,
+                           channel_t *ch, channel_tag_t *ct)
+{
+  mpegts_network_t *mn;
+  mpegts_mux_t *mm;
+  int state;
+
+  LIST_FOREACH(mn, &mpegts_network_all, mn_global_link) {
+    LIST_FOREACH(mm, &mn->mn_muxes, mm_network_link) {
+      if (mm == (mpegts_mux_t *)owner)
+        continue;
+
+      if (!idnode_is_instance(&mm->mm_id, &iptv_mux_class))
+        continue;
+
+      state = g3aw_managed_link_lookup((iptv_mux_t *)mm, ch, ct);
+
+      /*
+       * 1 = another owner, -1 = corrupt/unknown ledger.
+       * Both cases prohibit removing the association.
+       */
+      if (state != 0)
+        return 0;
+    }
+  }
+
+  return 1;
+}
+
+static void
+g3aw_reconcile_obsolete_owned_tags(mpegts_mux_t *mm)
+{
+  iptv_mux_t *im = (iptv_mux_t *)mm;
+  const char *ledger = im->mm_iptv_managed_tag_links;
+  char *snapshot;
+  size_t length, offset;
+
+  lock_assert(&global_lock);
+
+  if (!ledger || !*ledger)
+    return;
+
+  length = strnlen(ledger, 1048577);
+
+  if (length < 3 || length > 1048576 ||
+      memcmp(ledger, "v1\n", 3) ||
+      (length - 3) % 66)
+    return;
+
+  snapshot = strdup(ledger);
+  if (!snapshot)
+    return;
+
+  for (offset = 3; offset < length; offset += 66) {
+    const char *entry = snapshot + offset;
+    mpegts_service_t *ms;
+    idnode_list_mapping_t *service_link, *tag_link;
+    channel_t *ch;
+    channel_tag_t *ct;
+    char channel_uuid[UUID_HEX_SIZE];
+    char tag_uuid[UUID_HEX_SIZE];
+    int processed = 0;
+
+    /*
+     * Identify only objects linked to services of the owning mux.
+     * Never resolve by display name or create missing objects.
+     */
+    LIST_FOREACH(ms, &mm->mm_services, s_dvb_mux_link) {
+      LIST_FOREACH(service_link, &ms->s_channels, ilm_in1_link) {
+        ch = (channel_t *)service_link->ilm_in2;
+
+        if (!ch)
+          continue;
+
+        idnode_uuid_as_str(&ch->ch_id, channel_uuid);
+
+        if (memcmp(entry, channel_uuid, 32))
+          continue;
+
+        LIST_FOREACH(tag_link, &ch->ch_ctms, ilm_in2_link) {
+          ct = (channel_tag_t *)tag_link->ilm_in1;
+
+          if (!ct)
+            continue;
+
+          idnode_uuid_as_str(&ct->ct_id, tag_uuid);
+
+          if (entry[32] != ':' ||
+              memcmp(entry + 33, tag_uuid, 32) ||
+              entry[65] != '\n')
+            continue;
+
+          /*
+           * The complete owner ledger must validate, including
+           * duplicate records not related to this association.
+           */
+          if (g3aw_managed_link_lookup(im, ch, ct) != 1)
+            continue;
+
+          if (!g3aw_no_other_ledger_owner(im, ch, ct))
+            continue;
+
+          if (g3aw_evaluate_channel_tag_dependency(im, ch, ct) !=
+              G3AW_TAG_DEPENDENCY_OBSOLETE_CANDIDATE)
+            continue;
+
+          /*
+           * Allocate the updated ledger BEFORE unlinking.
+           * Allocation failure must not change channel relations.
+           */
+          {
+            const char *current = im->mm_iptv_managed_tag_links;
+            size_t current_len = strlen(current);
+            size_t pos;
+            char *updated = NULL;
+
+            for (pos = 3; pos + 66 <= current_len; pos += 66) {
+              if (memcmp(current + pos, entry, 66) == 0)
+                break;
+            }
+
+            if (pos + 66 > current_len)
+              continue;
+
+            updated = malloc(current_len - 66 + 1);
+
+            if (!updated)
+              continue;
+
+            memcpy(updated, current, pos);
+            memcpy(updated + pos, current + pos + 66,
+                   current_len - pos - 66);
+            updated[current_len - 66] = '\0';
+
+            if (channel_tag_unmap_exact(ct, ch)) {
+              im->mm_iptv_managed_tag_links = updated;
+              free((char *)current);
+              idnode_changed(&im->mm_id);
+
+              tvhinfo(LS_IPTV,
+                      "G3AW-R2C26: obsolete owned tag "
+                      "association removed");
+            } else {
+              free(updated);
+            }
+          }
+
+          processed = 1;
+          break;
+        }
+
+        if (processed)
+          break;
+      }
+
+      if (processed)
+        break;
+    }
+  }
+
+  free(snapshot);
+}
