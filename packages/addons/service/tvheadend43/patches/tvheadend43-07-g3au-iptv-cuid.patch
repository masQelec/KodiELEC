+/*
+ * G3-AL laboratory candidate: snapshot effective names before changing the
+ * IPTV mux name; notify only auto-named channels whose effective name changed.
+ */
+typedef struct iptv_auto_channel_snapshot {
+  channel_t *channel;
+  char *old_name;
+} iptv_auto_channel_snapshot_t;
+
+static void
+iptv_auto_channel_snapshots_free(iptv_auto_channel_snapshot_t *items, size_t count)
+{
+  size_t i;
+  for (i = 0; i < count; i++)
+    free(items[i].old_name);
+  free(items);
+}
+
+static int
+iptv_auto_channel_snapshots_take(mpegts_mux_t *mm,
+                                 iptv_auto_channel_snapshot_t **items,
+                                 size_t *count)
+{
+  mpegts_service_t *ms;
+  idnode_list_mapping_t *ilm;
+  iptv_auto_channel_snapshot_t *new_items;
+  channel_t *ch;
+  const char *name;
+  size_t i;
+
+  LIST_FOREACH(ms, &mm->mm_services, s_dvb_mux_link) {
+    LIST_FOREACH(ilm, &ms->s_channels, ilm_in1_link) {
+      ch = (channel_t *)ilm->ilm_in2;
+      if (!ch->ch_autoname || (ch->ch_name && *ch->ch_name))
+        continue;
+      for (i = 0; i < *count; i++)
+        if ((*items)[i].channel == ch)
+          break;
+      if (i < *count)
+        continue;
+
+      new_items = realloc(*items, (*count + 1) * sizeof(**items));
+      if (!new_items)
+        return -1;
+      *items = new_items;
+      (*items)[*count].channel = ch;
+      (*items)[*count].old_name = NULL;
+      (*count)++;
+      name = channel_get_name(ch, NULL);
+      (*items)[*count - 1].old_name = strdup(name ?: "");
+      if (!(*items)[*count - 1].old_name)
+        return -1;
+    }
+  }
+  return 0;
+}
+
+
+/*
+ * G3-AN candidate, synthetic HTTP playlist laboratory only:
+ * Preflight CUID uniqueness and active-mux URL changes BEFORE mutating any mux.
+ * No name-based adoption, no silent duplicate CUID or ambiguous URL mapping.
+ */
+static int
+g3an_valid_cuid(const char *s)
+{
+  size_t n;
+  if (s == NULL || !*s) return 0;
+  for (n = 0; s[n]; n++) {
+    if (n >= 128 ||
+        !((s[n] >= 'a' && s[n] <= 'z') ||
+          (s[n] >= 'A' && s[n] <= 'Z') ||
+          (s[n] >= '0' && s[n] <= '9') ||
+          s[n] == '-' || s[n] == '_' || s[n] == '.'))
+      return 0;
+  }
+  return 1;
+}
+
+static int
+g3an_preflight(iptv_network_t *in, htsmsg_t *items)
+{
+  htsmsg_field_t *f, *g;
+  htsmsg_t *item, *other;
+  const char *cuid, *other_cuid, *url;
+  mpegts_mux_t *mm;
+  iptv_mux_t *im;
+  int matches, legacy;
+  HTSMSG_FOREACH(f, items) {
+    item = htsmsg_field_get_map(f);
+    if (!item) continue;
+    cuid = htsmsg_get_str(item, "CUID");
+    if (cuid) {
+      if (!g3an_valid_cuid(cuid)) {
+        tvherror(LS_IPTV, "G3-AN invalid CUID in playlist");
+        return -1;
+      }
+      HTSMSG_FOREACH(g, items) {
+        if (g == f) break;
+        other = htsmsg_field_get_map(g);
+        if (!other) continue;
+        other_cuid = htsmsg_get_str(other, "CUID");
+        if (other_cuid && strcmp(cuid, other_cuid) == 0) {
+          tvherror(LS_IPTV, "G3-AN duplicate CUID, refusing playlist");
+          return -1;
+        }
+        if (other_cuid &&
+            (url = htsmsg_get_str(item, "m3u-url")) &&
+            strcmp(url, htsmsg_get_str(other, "m3u-url") ?: "") == 0) {
+          tvherror(LS_IPTV, "G3-AN duplicated URL with distinct CUID");
+          return -1;
+        }
+      }
+      matches = 0;
+      legacy = 0;
+      LIST_FOREACH(mm, &in->mn_muxes, mm_network_link) {
+        im = (iptv_mux_t *)mm;
+        if (im->mm_iptv_cuid && strcmp(im->mm_iptv_cuid, cuid) == 0)
+          matches++;
+        else if (im->mm_iptv_cuid &&
+                 (url = htsmsg_get_str(item, "m3u-url")) &&
+                 strcmp(im->mm_iptv_url_sane ?: (im->mm_iptv_url ?: ""), url) == 0) {
+          tvherror(LS_IPTV, "G3-AN existing URL belongs to another CUID");
+          return -1;
+        } else if (!im->mm_iptv_cuid &&
+                   (url = htsmsg_get_str(item, "m3u-url")) &&
+                   strcmp(im->mm_iptv_url_sane ?: (im->mm_iptv_url ?: ""), url) == 0)
+          legacy++;
+      }
+      if (matches > 1 || (!matches && legacy > 1)) {
+        tvherror(LS_IPTV, "G3-AN ambiguous existing CUID/URL mapping");
+        return -1;
+      }
+      /* G3-AO: do not reject a URL config refresh solely because a mux
+       * is active. IPTV input snapshots the running stream URL separately
+       * in mm_iptv_url_raw at start; do not force-stop that input. */
+    } else {
+      /* Losing a previously assigned CUID must not silently recreate a mux. */
+      url = htsmsg_get_str(item, "m3u-url");
+      if (url) LIST_FOREACH(mm, &in->mn_muxes, mm_network_link) {
+        im = (iptv_mux_t *)mm;
+        if (im->mm_iptv_cuid &&
+            strcmp(im->mm_iptv_url_sane ?: (im->mm_iptv_url ?: ""), url) == 0) {
+          tvherror(LS_IPTV, "G3-AN missing CUID for established mux");
+          return -1;
+        }
+      }
+    }
+  }
+  return 0;
+}
